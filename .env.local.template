VITE_SUPABASE_ANON_KEY="<Test Anon Key>"
VITE_SUPABASE_URL='http://127.0.0.1:54321'
SUPABASE_SERVICE_ROLE_KEY="<Test Service Role Key>"

# Optional: identify the existing Supabase account that should become Brepia's
# first administrator. Recommended when an installation already has multiple
# users. If unset, Brepia may bootstrap automatically only when exactly one auth
# user exists, making that sole existing account the administrator.
# PCAD_ADMIN_EMAIL="admin@example.com"

# Optional: SSO-only mode. Set to a Supabase OAuth provider slug, for example
# 'custom:my-idp' for a custom OIDC provider configured in Supabase. In this
# mode the application root owns the signed-out entry flow and the native
# sign-in/sign-up routes redirect through the configured provider.
# VITE_SSO_PROVIDER="custom:my-idp"

# Optional: when SSO owns the identity, point account/profile management at the
# provider's account page instead of editing those identity fields in Brepia.
# VITE_ACCOUNT_URL="https://accounts.example.com/account"

VITE_POSTHOG_PROJECT_KEY="<Test PostHog Project Key>"
VITE_SENTRY_ENVIRONMENT="local"
VITE_SENTRY_DSN="<Sentry DSN>"

ANTHROPIC_API_KEY="<Test Anthropic API Key>"
OPENROUTER_API_KEY="<Test OpenRouter API Key>"
OPENAI_API_KEY="<Test OpenAI API Key>"
GOOGLE_API_KEY="<Test Google API Key>"

# Custom provider credentials are encrypted server-side. ./start.sh creates a
# persistent local 256-bit key automatically when this is unset. For managed
# deployments, provide a stable 32-byte hex key and keep it secret.
# PCAD_CREDENTIAL_ENCRYPTION_KEY="<64 hex characters>"

# TRELLIS.2 is the built-in local Creative 3D product mode. Local runtime model
# IDs are selected in Settings > AI > Creative models and discovered from
# llama-swap. These connection/runtime overrides are optional.
# PCAD_LLAMA_SWAP_URL="http://127.0.0.1:9292"
# PCAD_LLAMA_SWAP_API_KEY="<Optional llama-swap bearer token>"
# PCAD_TRELLIS2_RESOLUTION="1024"  # deployment/legacy fallback; profile wins
# PCAD_Z_IMAGE_SIZE="1024x1024"

# Hosted Creative providers are opt-in. To expose fal.ai models in the picker
# and enable their server route:
# VITE_PCAD_CREATIVE_MESH_PROVIDERS="fal"
# FAL_KEY="<Fal API Key>"

ENVIRONMENT="local"

# Optional public callback origin for integrations that need an externally
# reachable application URL. If unset, the request origin is used.
# WEBHOOK_BASE_URL="https://brepia.example.com"

# In local mode, signed Supabase URLs may need to be rewritten to a public
# Supabase/ngrok origin for external consumers. Set only when that workflow is
# used.
# NGROK_URL="https://example.ngrok.app"

# Optional local root for persistent per-conversation artifacts. Relative paths
# are resolved from the Brepia process working directory. When unset, Brepia
# uses ./conversations. The default directory is gitignored.
# PCAD_CONVERSATIONS_DIR="/home/user/brepia-data/conversations"

# STEP CAD exchange export runs native OpenSCAD/scad123d only inside an
# operator-controlled sandbox because Brepia can execute user-imported SCAD.
# Build the repository's hardened Podman image first:
#   ./scripts/step-export/build-image.sh
# Then point the server at the runner (use an absolute path in production):
# PCAD_STEP_EXPORT_RUNNER="/path/to/brepia/scripts/step-export/pcad-scad2step-sandbox"
# Optional sandbox overrides. Defaults are intentionally conservative.
# PCAD_STEP_EXPORT_IMAGE="localhost/pcad-step-export:scad123d-0.5.0"
# PCAD_PODMAN_BIN="podman"
# PCAD_STEP_EXPORT_MEMORY="4g"
# PCAD_STEP_EXPORT_CPUS="2"
# PCAD_STEP_EXPORT_PIDS_LIMIT="256"
# PCAD_STEP_EXPORT_CONTAINER_TIMEOUT_SECONDS="40"
# PCAD_STEP_EXPORT_TMPFS_SIZE="512m"
# PCAD_STEP_EXPORT_MAX_CONCURRENT="1"

# Optional model allow-list for the Codex agent picker. Codex exposes no
# supported API that enumerates account-entitled models; "Codex (default)" is
# always available and uses the local Codex profile.
# CODEX_MODELS="model-a,model-b"

# OpenCode server configuration.
#
# If OPENCODE_BASE_URL is set, Brepia treats that server as externally managed
# and does not start an OpenCode child process.
# OPENCODE_BASE_URL="http://127.0.0.1:4096"
#
# If OPENCODE_BASE_URL is unset, ./start.sh starts a Brepia-managed loopback
# server. Leave OPENCODE_PORT unset to select a free port dynamically, or set it
# to request a fixed port.
# OPENCODE_PORT="4096"
#
# Optional HTTP Basic Auth used for both the managed server and Brepia's API
# requests to OpenCode. Username defaults to "opencode" when only a password is
# configured.
# OPENCODE_SERVER_USERNAME="opencode"
# OPENCODE_SERVER_PASSWORD="<Strong local secret>"

# Vision fallback models are selected in Settings > AI > Vision and reuse the
# provider Base URL / credential configured under Settings > AI > Providers.

# Shared bearer secret for the internal server-to-server account-purge endpoint
# (POST /api/internal/account/delete). The upstream identity provider's purge
# worker presents this to erase a user's Brepia data when their account is
# deleted. Leave unset to hard-disable the endpoint (it returns 503). Enable it
# only when a real purge worker is configured and use a strong deployment secret.
# ACCOUNT_PURGE_SECRET="<Strong shared account-purge secret>"
