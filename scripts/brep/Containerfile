FROM python:3.12-slim
ARG BUILD123D_VERSION=0.11.1
ARG CADQUERY_OCP_NOVTK_VERSION=7.9.3.1.1
ARG RHINO3DM_VERSION=8.32.1
ENV VIRTUAL_ENV=/opt/brepia-brep-venv PATH=/opt/brepia-brep-venv/bin:/usr/local/bin:/usr/bin:/bin HOME=/tmp
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 && rm -rf /var/lib/apt/lists/* \
  && python -m venv "$VIRTUAL_ENV" \
  && "$VIRTUAL_ENV/bin/pip" install --no-cache-dir "build123d==${BUILD123D_VERSION}" "cadquery-ocp-novtk==${CADQUERY_OCP_NOVTK_VERSION}" "rhino3dm==${RHINO3DM_VERSION}" \
  && "$VIRTUAL_ENV/bin/python" -c "import importlib.metadata as m; import build123d, OCP, rhino3dm; assert m.version('build123d') == '${BUILD123D_VERSION}'; assert m.version('cadquery-ocp-novtk') == '${CADQUERY_OCP_NOVTK_VERSION}'; assert m.version('rhino3dm') == '${RHINO3DM_VERSION}'; print('build123d=' + build123d.__version__); print('cadquery-ocp-novtk=' + m.version('cadquery-ocp-novtk')); print('OCP=' + OCP.__version__); print('rhino3dm=' + m.version('rhino3dm'))"
WORKDIR /output
