FROM debian:trixie-slim AS openscad-builder

ARG OPENSCAD_COMMIT=1ee676b0ea2e23a86553a931ff1d805fae7bbe7c

ENV DEBIAN_FRONTEND=noninteractive

# Bootstrap only what is needed to fetch the pinned source. OpenSCAD's own
# dependency script below remains the source of truth for build dependencies.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN set -eux; \
  git clone https://github.com/openscad/openscad.git /src/openscad; \
  cd /src/openscad; \
  git checkout "${OPENSCAD_COMMIT}"; \
  git submodule update --init --recursive; \
  test "$(git rev-parse HEAD)" = "${OPENSCAD_COMMIT}"

WORKDIR /src/openscad

# Mirror OpenSCAD's Linux CI for this source generation: Qt6 with a headless
# build. The builder stage is discarded, so compiler/dev packages do not ship
# in the STEP runtime image.
RUN ./scripts/uni-get-dependencies.sh qt6

# OpenSCAD added an unconditional OpenSSL dependency in June 2026, but the
# dependency helper at this pinned August commit does not yet install libssl-dev.
# GitHub's ubuntu-latest image happens to provide it already; a clean Debian
# builder does not. Keep this explicit compatibility shim next to the upstream
# dependency script so CMake configuration is reproducible outside CI.
RUN apt-get update \
  && apt-get install -y --no-install-recommends libssl-dev \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  test -f /usr/include/openssl/ssl.h; \
  pkg-config --modversion openssl; \
  cmake -S . -B build -GNinja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DHEADLESS=ON \
    -DENABLE_MANIFOLD=ON \
    -DENABLE_TESTS=OFF; \
  cmake --build build --parallel 2; \
  cmake --install build; \
  /usr/local/bin/openscad --version

# Derive the Debian runtime package set from the exact binary we just built.
# dpkg-query -S may emit dpkg-divert diagnostics such as "diversion by ..."
# before the real package owner. Accept only canonical package[:arch]: /path
# records so diagnostic words can never become apt package names.
RUN set -eux; \
  ldd /usr/local/bin/openscad | tee /tmp/openscad-ldd.txt; \
  ! grep -q 'not found' /tmp/openscad-ldd.txt; \
  awk '($2 == "=>" && $3 ~ /^\//) { print $3 } ($1 ~ /^\//) { print $1 }' \
    /tmp/openscad-ldd.txt | sort -u > /tmp/openscad-runtime-libs.txt; \
  : > /tmp/openscad-runtime-packages.unsorted; \
  while IFS= read -r lib; do \
    resolved="$(readlink -f "$lib" 2>/dev/null || printf '%s' "$lib")"; \
    package=""; \
    for candidate in "$lib" "$resolved"; do \
      package="$( \
        dpkg-query -S "$candidate" 2>/dev/null \
          | sed -nE 's/^([A-Za-z0-9][A-Za-z0-9+.-]*(:[A-Za-z0-9][A-Za-z0-9-]*)?): \/.*/\1/p' \
          | head -n 1 \
          || true \
      )"; \
      if [ -n "$package" ]; then \
        break; \
      fi; \
    done; \
    if [ -n "$package" ]; then \
      printf '%s\n' "$package" >> /tmp/openscad-runtime-packages.unsorted; \
    else \
      printf 'No Debian package owner found for runtime library: %s\n' "$lib" >&2; \
      exit 1; \
    fi; \
  done < /tmp/openscad-runtime-libs.txt; \
  sort -u /tmp/openscad-runtime-packages.unsorted > /tmp/openscad-runtime-packages.txt; \
  test -s /tmp/openscad-runtime-packages.txt; \
  if grep -Ev '^[A-Za-z0-9][A-Za-z0-9+.-]*(:[A-Za-z0-9][A-Za-z0-9-]*)?$' \
      /tmp/openscad-runtime-packages.txt; then \
    echo 'Invalid generated Debian runtime package name(s).' >&2; \
    exit 1; \
  fi; \
  cat /tmp/openscad-runtime-packages.txt


FROM debian:trixie-slim

ARG OPENSCAD_COMMIT=1ee676b0ea2e23a86553a931ff1d805fae7bbe7c
ARG SCAD123D_VERSION=0.5.0
ARG SCAD123D_COMMIT=c5d126ac30e8f170e2082aa14ad4a44c6d70513e

ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/pcad-step-venv
ENV PATH="/opt/pcad-step-venv/bin:/usr/local/bin:/usr/bin:/bin"
ENV OPENSCADPATH=/opt/openscad-libraries
ENV HOME=/tmp
ENV PCAD_OPENSCAD_COMMIT=${OPENSCAD_COMMIT}

COPY --from=openscad-builder /usr/local/ /usr/local/
COPY --from=openscad-builder /tmp/openscad-runtime-packages.txt /tmp/openscad-runtime-packages.txt

# Install only the runtime packages required by the pinned OpenSCAD binary,
# plus Python/scad123d prerequisites and a small deterministic font baseline
# for OpenSCAD text() models.
RUN set -eux; \
  apt-get update; \
  xargs -r apt-get install -y --no-install-recommends \
    < /tmp/openscad-runtime-packages.txt; \
  apt-get install -y --no-install-recommends \
    ca-certificates \
    fontconfig \
    fonts-dejavu-core \
    python3 \
    python3-pip \
    python3-venv \
    unzip; \
  rm -rf /var/lib/apt/lists/* /tmp/openscad-runtime-packages.txt; \
  ldd /usr/local/bin/openscad | tee /tmp/openscad-final-ldd.txt; \
  ! grep -q 'not found' /tmp/openscad-final-ldd.txt; \
  openscad --version; \
  printf '%s\n' \
    'difference() {' \
    '  cube([10, 10, 10]);' \
    '  translate([5, 5,-1]) cylinder(h=12, r=2, $fn=32);' \
    '}' > /tmp/openscad-build-smoke.scad; \
  openscad -o /tmp/openscad-build-smoke.csg /tmp/openscad-build-smoke.scad; \
  test -s /tmp/openscad-build-smoke.csg; \
  rm -f /tmp/openscad-final-ldd.txt /tmp/openscad-build-smoke.scad /tmp/openscad-build-smoke.csg

# Pin scad123d to an immutable upstream commit whose package metadata reports
# 0.5.0. Runtime package downloads remain impossible because the Podman runner
# starts this image with --network=none.
RUN python3 -m venv "${VIRTUAL_ENV}" \
  && "${VIRTUAL_ENV}/bin/pip" install --no-cache-dir --upgrade pip \
  && "${VIRTUAL_ENV}/bin/pip" install --no-cache-dir \
    "https://github.com/etjones/scad123d/archive/${SCAD123D_COMMIT}.tar.gz" \
  && "${VIRTUAL_ENV}/bin/python" -c \
    "import importlib.metadata as m; assert m.version('scad123d') == '${SCAD123D_VERSION}', m.version('scad123d')"

# Use exactly the OpenSCAD libraries bundled with pCAD so browser preview and
# server-side STEP conversion resolve BOSL/BOSL2/MCAD against the same inputs.
COPY public/libraries/BOSL.zip /tmp/pcad-libraries/BOSL.zip
COPY public/libraries/BOSL2.zip /tmp/pcad-libraries/BOSL2.zip
COPY public/libraries/MCAD.zip /tmp/pcad-libraries/MCAD.zip
RUN set -eux; \
  mkdir -p \
    /opt/openscad-libraries/BOSL \
    /opt/openscad-libraries/BOSL2 \
    /opt/openscad-libraries/MCAD; \
  unzip -q /tmp/pcad-libraries/BOSL.zip -d /opt/openscad-libraries/BOSL; \
  unzip -q /tmp/pcad-libraries/BOSL2.zip -d /opt/openscad-libraries/BOSL2; \
  unzip -q /tmp/pcad-libraries/MCAD.zip -d /opt/openscad-libraries/MCAD; \
  rm -rf /tmp/pcad-libraries

WORKDIR /output
ENTRYPOINT ["/opt/pcad-step-venv/bin/scad2step"]
